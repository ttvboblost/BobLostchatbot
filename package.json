{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/api-server",
    "lib/db",
    "lib/api-zod"
  ],
  "scripts": {
    "build": "npm run build --workspace=@workspace/api-server",
    "start": "npm run start --workspace=@workspace/api-server",
    "typecheck:libs": "tsc --build lib/db lib/api-zod",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspace=@workspace/api-server"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}